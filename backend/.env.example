# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=clinisalud_secret_key_2026

# Database (PostgreSQL)
# Local: postgresql://clinisalud:clinisalud@localhost:5432/clinisalud
# Docker compose: postgresql://clinisalud:clinisalud@db:5432/clinisalud
DATABASE_URL=postgresql://clinisalud:clinisalud@localhost:5432/clinisalud

# DB sync mode: 'force' recrea el esquema y ejecuta seeders (SOLO dev inicial).
# Cualquier otro valor (o ausente) arranca sin modificar datos.
DB_SYNC=normal

# Logging
LOG_LEVEL=info

# SMTP (Email) - Para Gmail usar smtp.gmail.com con un "App Password" (Cuenta Google > Seguridad > Contraseñas de aplicaciones)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_correo@gmail.com
SMTP_PASS=tu_app_password
SMTP_FROM=Clinisalud <tu_correo@gmail.com>